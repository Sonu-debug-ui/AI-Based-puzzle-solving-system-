# ==============================================================
# Puzzl — AI Configuration (.env.example)
# Copy this file to .env and configure your keys as needed.
# ==============================================================

# --------------------------------------------------------------
# Option A: OpenRouter API (Recommended for flexible Claude access)
# Key format starts with: sk-or-v1-...
# --------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: OpenRouter Model Overrides
# Defaults to anthropic/claude-3.5-sonnet for logic parsing and anthropic/claude-3.5-haiku for hints
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_EXPLAINER_MODEL=anthropic/claude-3.5-haiku

# --------------------------------------------------------------
# Option B: Direct Anthropic API
# Key format starts with: sk-ant-...
# --------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_EXPLAINER_MODEL=claude-3-5-haiku-20241022

# --------------------------------------------------------------
# Optional: Operator Cost Estimation (USD per million tokens for /metrics)
# --------------------------------------------------------------
# ANTHROPIC_PARSER_INPUT_USD_PER_MILLION=3.00
# ANTHROPIC_PARSER_OUTPUT_USD_PER_MILLION=15.00
# ANTHROPIC_EXPLAINER_INPUT_USD_PER_MILLION=0.80
# ANTHROPIC_EXPLAINER_OUTPUT_USD_PER_MILLION=4.00

